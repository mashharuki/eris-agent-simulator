+// eris: native solc on Linux ARM (Raspberry Pi, Graviton). Hardhat only downloads linux-amd64 solc,
+// marks it `.does.not.work` on arm64 and falls back to solcjs (wasm), which is too slow / runs out of
+// memory on this repo's 150+ contracts. Foundry's svm ships native aarch64 builds, so use those:
+// GMX_SOLC_PATH wins, else svm's install dir. Other platforms keep hardhat's own download.
+const findNativeSolc = (version: string): string | undefined => {
+  if (process.env.GMX_SOLC_PATH) return process.env.GMX_SOLC_PATH;
+  if (process.platform !== "linux" || process.arch !== "arm64") return undefined;
+  const candidates = [
+    path.join(os.homedir(), ".local/share/svm", version, `solc-${version}`),
+    path.join(os.homedir(), ".svm", version, `solc-${version}`),
+  ];
+  return candidates.find((p) => fs.existsSync(p));
+};
