+    if (process.platform === "linux" && process.arch === "arm64") {
+      console.warn(
+        `[eris] no native solc ${args.solcVersion} for linux-arm64 -- falling back to solcjs (slow). ` +
+          "Run deployer/scripts/setup-vendors.sh or set GMX_SOLC_PATH."
+      );
+    }
+    return runSuper(args);
+  }
