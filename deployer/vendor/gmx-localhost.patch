+  const out = execFileSync(compilerPath, ["--version"], { encoding: "utf8" });
+  const longVersion = out.match(/Version:\s*(\S+?\+commit\.[0-9a-f]+)/)?.[1];
+  if (!longVersion?.startsWith(`${args.solcVersion}+`)) {
+    throw new Error(`[eris] ${compilerPath} is not solc ${args.solcVersion}: ${out.trim()}`);
+  }
