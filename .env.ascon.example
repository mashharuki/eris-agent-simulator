# ASCON practice chain — self-hosted agent credentials (copy to .env.ascon; .env.ascon is gitignored).
#   cp .env.ascon.example .env.ascon && $EDITOR .env.ascon && npm run agent:ascon
# Values already exported in the shell win over this file.

# --- RPC (ERIS_RPC_URL overrides the manifest's chain.rpcUrl) ---
ERIS_RPC_URL=https://ascon-rpc.nyx.foundation/
CHAIN_ID=31337

# --- Gateway headers (all three required, otherwise 403) ---
# X-ASCON-Key: team-only; it is the unit for usage logs and rate limits. Never share it.
ASCON_KEY=
# CF-Access-Client-Id / -Secret: shared by all teams (the organizers' CF_ID / CF_SECRET names also work)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Your agent ---
# Wallet key for signing locally (eth_sendRawTransaction). Post only the address to the Discord faucet channel.
ERIS_AGENT_PRIVATE_KEY=
ERIS_AGENT_ID=my-team
ERIS_AGENT_DIR=example/agents/venue-arb
ERIS_RUN_DIR=./runs/ascon
# The environment manifest the operators publish (contract addresses incl. PriceFeed). If you don't use one,
# set ERIS_PRICE_FEED_ADDRESS instead.
ERIS_MANIFEST=./manifest.ascon.json
# ERIS_PRICE_FEED_ADDRESS=0x...
# ERIS_CONFIG=config/local.yaml
